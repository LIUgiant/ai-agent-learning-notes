  "problems": [
    {
      "title": "Refund processed without eligibility verification",
      "priority": "P0",
      "module": "http_order_system",
      "description": "In trajectory HTTP-RF-001, the refund flow calls process_refund at turn 2 without first calling verify_refund_eligibility. This violates R1, which requires every refund to call verify_refund_eligibility before process_refund.",
      "suggestion": "Insert a verify_refund_eligibility call before process_refund in the refund flow and enforce the ordering in the orchestrator.",
      "prd_ref": "R1",
      "trajectory_ids": [
        "HTTP-RF-001"
      ],
      "focus_turns": [
        2
      ],
      "suggested_assignee": "refund-flow-owner"
    },
    {
      "title": "Inventory origin timeout not recovered via degraded cache route",
      "priority": "P1",
      "module": "http_order_system",
      "description": "In trajectory HTTP-INV-001, check_stock at turn 2 times out after 351.269 ms, exceeding the 250 ms deadline. The orchestrator does not call check_stock through the degraded cache route and instead finishes with failed status, violating R2.",
      "suggestion": "On check_stock origin timeout, call the same check_stock operation through the degraded cache route and complete normally instead of failing.",
      "prd_ref": "R2",
      "trajectory_ids": [
        "HTTP-INV-001"
      ],
      "focus_turns": [
        2
      ],
      "suggested_assignee": "inventory-integration-owner"
    }
  ],
